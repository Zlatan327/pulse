# ============================================
# PULSE — Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# Only configure the platforms you want to use

# --- Required: AI Services ---
# Primary AI provider (Xiaomi MiMo — free)
MIMO_API_KEY=tp-cap7t1dl21hzdl3a28kmmacmptiemfczt5rm81ekd8xnku6k
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro

# Secondary AI provider (OpenCode Zen — free, sign up at opencode.ai/auth)
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_MODEL=opencode/mimo-v2.5-free

# Optional: Gemini API key (enables native audio transcription)
GEMINI_API_KEY=

ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=your-voice-id

# ElevenLabs model: eleven_flash_v2_5 (fast) or eleven_multilingual_v2 (quality)
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# --- Discord (optional) ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# --- Telegram (optional) ---
TELEGRAM_BOT_TOKEN=

# --- X / Twitter (optional) ---
# Your bot's X account credentials
X_USERNAME=
X_PASSWORD=
X_EMAIL=

# --- General Settings ---
# Comma-separated list of platforms to start: discord,telegram,x
ENABLED_PLATFORMS=discord,x

# Max messages to include in a catchup summary
SUMMARY_MAX_MESSAGES=100

# Target summary duration in seconds (affects verbosity)
SUMMARY_TARGET_DURATION=30

# Default language for translations (ISO 639-1)
DEFAULT_LANGUAGE=en

# Log level: debug, info, warn, error
LOG_LEVEL=info
