# ============================================
# PULSE — Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# Only configure the platforms you want to use

# --- Required: AI Services ---
GEMINI_API_KEY=your-gemini-api-key
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=your-voice-id

# ElevenLabs model: eleven_flash_v2_5 (fast) or eleven_multilingual_v2 (quality)
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# --- Discord (optional) ---
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# --- Telegram (optional) ---
TELEGRAM_BOT_TOKEN=

# --- WhatsApp (optional) ---
# Set to true to enable the WhatsApp adapter (requires Chromium)
WHATSAPP_ENABLED=false

# --- General Settings ---
# Comma-separated list of platforms to start: discord,telegram,whatsapp
ENABLED_PLATFORMS=discord

# Max messages to include in a catchup summary
SUMMARY_MAX_MESSAGES=100

# Target summary duration in seconds (affects verbosity)
SUMMARY_TARGET_DURATION=30

# Default language for translations (ISO 639-1)
DEFAULT_LANGUAGE=en

# Log level: debug, info, warn, error
LOG_LEVEL=info
