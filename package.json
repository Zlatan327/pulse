{
  "name": "pulse",
  "version": "1.0.0",
  "description": "AI-first chat companion — audio summaries for Discord, Telegram & WhatsApp",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "start:discord": "tsx src/discord/index.ts",
    "start:telegram": "tsx src/telegram/index.ts",
    "start:whatsapp": "tsx src/whatsapp/index.ts",
    "start:x": "tsx src/x/index.ts",
    "deploy:discord": "tsx src/discord/deploy-commands.ts"
  },
  "keywords": [
    "chatbot",
    "ai",
    "discord",
    "telegram",
    "whatsapp",
    "summarizer",
    "tts"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@grammyjs/files": "^1.2.0",
    "agent-twitter-client": "^0.0.18",
    "better-sqlite3": "^12.10.0",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "elevenlabs": "^1.59.0",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "grammy": "^1.43.0",
    "https-proxy-agent": "^9.0.0",
    "pdf-parse": "^2.4.5",
    "whatsapp-web.js": "^1.34.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^25.9.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
